<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>闪电风暴策略助手</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
        body { background-color: #0b0f19; color: #f8fafc; display: flex; flex-direction: column; align-items: center; min-height: 100vh; padding: 15px; }
        h1 { font-size: 1.3rem; margin-bottom: 12px; color: #38bdf8; text-shadow: 0 0 10px rgba(56,189,248,0.4); text-align: center; }
        .strategy-bar { width: 100%; max-width: 400px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; margin-bottom: 15px; }
        .strat-btn { background: #1e293b; border: 1px solid #334155; color: #38bdf8; padding: 10px 4px; border-radius: 8px; font-size: 0.8rem; font-weight: bold; cursor: pointer; text-align: center; }
        .strat-btn:active { background: #0284c7; color: #fff; }
        .grid-container { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; width: 100%; max-width: 400px; margin-bottom: 15px; }
        .num-card { background: #1e293b; border: 2px solid #334155; border-radius: 12px; aspect-ratio: 1; display: flex; justify-content: center; align-items: center; font-size: 1.5rem; font-weight: bold; color: #f8fafc; cursor: pointer; user-select: none; }
        .num-card.excluded { opacity: 0.15; transform: scale(0.92); background: #0f172a; }
        .num-card.highlight { background: #ca8a04; border-color: #fde047; box-shadow: 0 0 18px rgba(253,224,71,0.6); transform: scale(1.08); color: #fff; }
        .controls { width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 10px; margin-bottom: 15px; }
        .btn-primary { background: linear-gradient(135deg, #0284c7, #2563eb); color: #fff; border: none; padding: 14px; border-radius: 10px; font-size: 1rem; font-weight: bold; cursor: pointer; }
        .btn-secondary { background: #1e293b; color: #94a3b8; border: 1px solid #334155; padding: 11px; border-radius: 10px; font-size: 0.9rem; cursor: pointer; }
        .result-box { width: 100%; max-width: 400px; background: #1e293b; border-radius: 10px; padding: 14px; text-align: center; font-size: 0.95rem; border: 1px solid #334155; line-height: 1.5; }
        .result-highlight { color: #fde047; font-weight: bold; font-size: 1.15rem; }
    </style>
</head>
<body>
    <h1>⚡ 闪电风暴策略助手</h1>
    <div class="strategy-bar">
        <button class="strat-btn" onclick="selectCombination('mx/小单')">小单 1,3,5..</button>
        <button class="strat-btn" onclick="selectCombination('mx/小双')">小双 2,4,6..</button>
        <button class="strat-btn" onclick="selectCombination('wma/大单')">大单 11,13..</button>
        <button class="strat-btn" onclick="selectCombination('wma/大双')">大双 12,14..</button>
    </div>
    <div class="grid-container" id="grid"></div>
    <div class="controls">
        <button class="btn-primary" onclick="pickThree()">🎲 Pick 3 (3key)</button>
        <button class="btn-secondary" onclick="resetAll()">🔄 Reset</button>
    </div>
    <div class="result-box" id="result">Click Strategy</div>
    <script>
        const grid = document.getElementById('grid');
        const result = document.getElementById('result');
        let state = Array(20).fill(true);
        function renderGrid() {
            grid.innerHTML = '';
            for (let i = 1; i <= 20; i++) {
                const card = document.createElement('div');
                card.className = `num-card ${state[i-1] ? '' : 'excluded'}`;
                card.innerText = i;
                card.onclick = () => { state[i-1] = !state[i-1]; renderGrid(); };
                card.id = `card-${i}`;
                grid.appendChild(card);
            }
        }
        function selectCombination(type) {
            for (let i = 1; i <= 20; i++) {
                const isSmall = i <= 10;
                const isEven = i % 2 === 0;
                if (type === 'mx/小单') state[i-1] = isSmall && !isEven;
                if (type === 'mx/小双') state[i-1] = isSmall && isEven;
                if (type === 'wma/大单') state[i-1] = !isSmall && !isEven;
                if (type === 'wma/大双') state[i-1] = !isSmall && isEven;
            }
            renderGrid();
            result.innerHTML = `OK: <span class="result-highlight">${type}</span>`;
        }
        function pickThree() {
            renderGrid();
            const available = [];
            state.forEach((active, index) => { if (active) available.push(index + 1); });
            if (available.length === 0) { result.innerHTML = 'No Number'; return; }
            const shuffled = [...available].sort(() => 0.5 - Math.random());
            const picked = shuffled.slice(0, Math.min(3, shuffled.length));
            const targetKey = picked[0];
            picked.forEach(num => {
                if (num === targetKey) document.getElementById(`card-${num}`).className = 'num-card highlight';
            });
            result.innerHTML = `Key: <span class="result-highlight">${targetKey}</span>`;
        }
        function resetAll() { state = Array(20).fill(true); renderGrid(); result.innerText = 'Reset'; }
        renderGrid();
    </script>
</body>
</html>
